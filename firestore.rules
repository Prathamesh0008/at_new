rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collectionId}/{document=**} {
      allow read, write: if !(collectionId in [
        'managerAttendanceHistory',
        'managerAttendanceApprovals',
        'managerAttendanceDaily',
        'managerAttendanceState'
      ]);
    }
  }
}
